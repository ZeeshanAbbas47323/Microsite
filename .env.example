NODE_ENV=development
ROOT_DOMAIN=getorio.com
# Local dev: use e.g. ROOT_DOMAIN=microstore.localhost so shop.microstore.localhost resolves to 127.0.0.1

DATABASE_URL=mysql://microstore:microstore@localhost:3306/microstore
REDIS_URL=redis://localhost:6379

SESSION_SECRET=change-me-to-a-long-random-string
SSO_JWT_PUBLIC_KEY=            # RS256 public key (PEM), or use SSO_SHARED_SECRET
SSO_SHARED_SECRET=             # HS256 shared secret (dev only)

GETORIO_CLIENT=mock            # mock | http
GETORIO_API_BASE_URL=
GETORIO_API_KEY=
GETORIO_WEBHOOK_SECRET=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
COMMANDS_PER_STORE_PER_DAY=30

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=microstore-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

SENTRY_DSN=
TURNSTILE_SECRET=              # optional

# docker-compose only
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=microstore
MYSQL_USER=microstore
MYSQL_PASSWORD=microstore
