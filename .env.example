NODE_ENV=development
ROOT_DOMAIN=getorio.com
STOREFRONT_URL_TEMPLATE=https://{host}
CORS_ORIGINS=http://localhost:3000
# Local dev: use e.g. ROOT_DOMAIN=microstore.localhost so shop.microstore.localhost resolves to 127.0.0.1

DATABASE_URL=mysql://microstore:microstore@localhost:3306/microstore
REDIS_URL=redis://localhost:6379
# Dev: run the order-sync worker inside the API process. Production: run `pnpm --filter @microstore/api start:worker`.
# apps/web <-> apps/api
WEB_PORT=3000
API_URL=http://localhost:4000
# Remote image hosts allowed by next/image (product images from Getorio, uploads bucket)
IMAGE_HOSTS=placehold.co
# Merchant dashboard origin (used for dev sign-in links)
DASHBOARD_URL=http://localhost:3000
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=
DASHBOARD_HOSTS=localhost,127.0.0.1,app.getorio.com
# Comma-separated proxy IPs/CIDRs (or true) whose X-Forwarded-For the API trusts, e.g. the web server
TRUST_PROXY=
RUN_WORKER_IN_PROCESS=false
# Integration tests create/reset this database (the docker-compose user may create databases)
DATABASE_URL_TEST=mysql://microstore:microstore@localhost:3306/microstore_test

SESSION_SECRET=change-me-to-a-long-random-string
# RS256 public key (PEM), or use SSO_SHARED_SECRET
SSO_JWT_PUBLIC_KEY=
# HS256 shared secret (dev only)
SSO_SHARED_SECRET=

# mock | http
GETORIO_CLIENT=mock
GETORIO_API_BASE_URL=
GETORIO_API_KEY=
GETORIO_WEBHOOK_SECRET=
# Link to an order inside Getorio, e.g. https://app.getorio.com/orders/{id}
GETORIO_ORDER_URL_TEMPLATE=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
COMMANDS_PER_STORE_PER_DAY=30

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=microstore-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

SENTRY_DSN=
# Optional Cloudflare Turnstile on checkout (both keys needed)
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# Customer order emails: SMTP URL (unset = logged only)
SMTP_URL=
MAIL_FROM=Microstore <no-reply@getorio.com>
# Optional SMS/WhatsApp hook (POST {to,text} with bearer token); disabled when unset
MESSAGE_WEBHOOK_URL=
MESSAGE_WEBHOOK_TOKEN=

# docker-compose only (change the host ports if 3306/6379/9000 are already taken locally)
S3_PORT=9000
MYSQL_PORT=3306
REDIS_PORT=6379
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=microstore
MYSQL_USER=microstore
MYSQL_PASSWORD=microstore
