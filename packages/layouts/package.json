{
  "name": "@microstore/layouts",
  "version": "0.1.0",
  "private": true,
  "description": "Layout registry (metadata + defaults) and, later, React section components",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "default": "./src/react/index.ts"
    }
  },
  "files": [
    "dist",
    "src/react"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@microstore/site-schema": "workspace:*"
  },
  "devDependencies": {
    "@microstore/config": "workspace:*",
    "@vitest/coverage-v8": "^4.0.0",
    "tsup": "^8.5.0",
    "vitest": "^4.0.0",
    "@types/react": "^19.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@types/react-dom": "^19.2.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
