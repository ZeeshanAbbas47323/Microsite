{
  "name": "@microstore/getorio-client",
  "version": "0.1.0",
  "private": true,
  "description": "Adapter for the Getorio OMS: interface, in-memory mock and HTTP implementation (server-only)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@microstore/config": "workspace:*",
    "@vitest/coverage-v8": "^4.0.0",
    "tsup": "^8.5.0",
    "vitest": "^4.0.0"
  }
}
