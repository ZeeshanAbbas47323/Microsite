# API + worker image. Build from the repo root:
#   docker build -f docker/Dockerfile.api -t microstore-api .
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /repo

FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter "@microstore/api..." build
# Self-contained production bundle of the API with its workspace dependencies.
RUN pnpm --filter @microstore/api deploy --prod /out \
 && cp -r apps/api/dist /out/dist

# Runs `prisma migrate deploy` (needs the Prisma CLI from dev dependencies).
FROM build AS migrate
WORKDIR /repo/apps/api
CMD ["pnpm", "exec", "prisma", "migrate", "deploy"]

FROM node:22-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /out ./
USER node
EXPOSE 4000
CMD ["node", "dist/server.js"]
