{
  "extends": "@microstore/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "allowJs": false,
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "src",
    ".next/types/**/*.ts",
    "next.config.ts",
    "vitest.config.ts",
    "test"
  ],
  "exclude": ["node_modules"]
}
