{
  "name": "@microstore/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "prisma generate && tsup",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@microstore/getorio-client": "workspace:*",
    "@microstore/layouts": "workspace:*",
    "@microstore/site-schema": "workspace:*",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "bullmq": "^5.81.0",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.0",
    "ioredis": "^5.6.0",
    "jose": "^6.1.0",
    "pino": "^9",
    "uuid": "^11.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@microstore/config": "workspace:*",
    "@vitest/coverage-v8": "^4.0.0",
    "dotenv": "^17.0.0",
    "prisma": "7.10.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "vitest": "^4.0.0"
  }
}
