// Microstore data model (requirements §7). MySQL 8, InnoDB, utf8mb4.
// Conventions: CHAR(36) UUIDv7 ids generated in app code, DATETIME(3) UTC timestamps,
// DECIMAL(12,2) money, JSON for configs/settings. Every tenant table carries getorio_tenant_id
// and is always queried with it. Never filter on values inside JSON columns.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum MerchantRole {
  owner
  staff
  platform_admin
}

enum StoreStatus {
  draft
  published
  suspended
}

enum DomainType {
  subdomain
  custom
}

enum VersionKind {
  published
  draft_revision
}

enum VersionSource {
  manual
  command
  publish
  restore
  generate
}

enum CommandStatus {
  proposed
  applied
  discarded
  rejected
  error
}

enum DiscountType {
  percentage
  fixed
  free_shipping
}

enum OrderStatus {
  pending_sync
  synced
  sync_failed
  cancelled
}

/// Local mapping of a Getorio user who has signed in through SSO.
model Merchant {
  id              String       @id @db.Char(36)
  getorioTenantId String       @map("getorio_tenant_id") @db.VarChar(64)
  getorioUserId   String       @map("getorio_user_id") @db.VarChar(64)
  role            MerchantRole
  lastLoginAt     DateTime     @map("last_login_at") @db.DateTime(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  stores Store[]

  @@unique([getorioTenantId, getorioUserId])
  @@map("merchants")
}

model Store {
  id                 String      @id @db.Char(36)
  /// One store per Getorio tenant in MVP (see docs/ASSUMPTIONS.md).
  getorioTenantId    String      @unique @map("getorio_tenant_id") @db.VarChar(64)
  ownerUserId        String      @map("owner_user_id") @db.Char(36)
  name               String      @db.VarChar(80)
  status             StoreStatus @default(draft)
  currency           String      @default("PKR") @db.Char(3)
  timezone           String      @default("Asia/Karachi") @db.VarChar(64)
  /// shippingFlatFee, freeShippingThreshold, notifications, whatsappButton, rtl
  settings           Json
  draftConfig        Json        @map("draft_config")
  publishedConfig    Json?       @map("published_config")
  publishedVersionId String?     @map("published_version_id") @db.Char(36)
  publishedAt        DateTime?   @map("published_at") @db.DateTime(3)
  suspendedAt        DateTime?   @map("suspended_at") @db.DateTime(3)
  storageUsedBytes   BigInt      @default(0) @map("storage_used_bytes")
  createdAt          DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  owner         Merchant         @relation(fields: [ownerUserId], references: [id])
  domains       Domain[]
  versions      SiteVersion[]
  commandLogs   CommandLog[]
  storeProducts StoreProduct[]
  orders        Order[]
  assets        Asset[]
  auditLogs     AuditLog[]
  dailyStats    StoreDailyStat[]
  customers     Customer[]
  discounts     Discount[]

  @@index([ownerUserId])
  @@map("stores")
}

/// Tenant resolution uses only this table (FR-9.2).
model Domain {
  id                 String     @id @db.Char(36)
  storeId            String     @map("store_id") @db.Char(36)
  getorioTenantId    String     @map("getorio_tenant_id") @db.VarChar(64)
  hostname           String     @unique @db.VarChar(253)
  type               DomainType
  verified           Boolean    @default(false)
  isPrimary          Boolean    @default(false) @map("is_primary")
  /// Old subdomains keep redirecting to the new primary for 30 days (FR-6.6).
  redirectToDomainId String?    @map("redirect_to_domain_id") @db.Char(36)
  redirectExpiresAt  DateTime?  @map("redirect_expires_at") @db.DateTime(3)
  /// Custom domains: value the merchant puts in a TXT record to prove ownership (Phase 4).
  verificationToken  String?    @map("verification_token") @db.VarChar(64)
  verifiedAt         DateTime?  @map("verified_at") @db.DateTime(3)
  lastCheckedAt      DateTime?  @map("last_checked_at") @db.DateTime(3)
  lastCheckError     String?    @map("last_check_error") @db.VarChar(255)
  createdAt          DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("domains")
}

model SiteVersion {
  id              String        @id @db.Char(36)
  storeId         String        @map("store_id") @db.Char(36)
  getorioTenantId String        @map("getorio_tenant_id") @db.VarChar(64)
  kind            VersionKind
  config          Json
  label           String?       @db.VarChar(120)
  createdBy       String?       @map("created_by") @db.Char(36)
  source          VersionSource
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, kind, createdAt])
  @@map("site_versions")
}

model CommandLog {
  id               String        @id @db.Char(36)
  storeId          String        @map("store_id") @db.Char(36)
  getorioTenantId  String        @map("getorio_tenant_id") @db.VarChar(64)
  userId           String        @map("user_id") @db.Char(36)
  commandText      String        @map("command_text") @db.VarChar(300)
  /// UI language the summary was requested in (en | ur).
  language         String        @default("en") @db.VarChar(5)
  /// Model's short human-readable summary of the change (or the clarification question).
  summary          String?       @db.VarChar(500)
  model            String        @db.VarChar(100)
  promptTokens     Int           @default(0) @map("prompt_tokens")
  completionTokens Int           @default(0) @map("completion_tokens")
  status           CommandStatus
  rejectionReason  String?       @map("rejection_reason") @db.VarChar(500)
  patch            Json?
  latencyMs        Int           @default(0) @map("latency_ms")
  createdAt        DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("command_logs")
}

model StoreProduct {
  id               String   @id @db.Char(36)
  storeId          String   @map("store_id") @db.Char(36)
  getorioTenantId  String   @map("getorio_tenant_id") @db.VarChar(64)
  getorioProductId String   @map("getorio_product_id") @db.VarChar(64)
  visible          Boolean  @default(true)
  featured         Boolean  @default(false)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, getorioProductId])
  @@index([storeId, visible])
  @@map("store_products")
}

model Order {
  id              String      @id @db.Char(36)
  storeId         String      @map("store_id") @db.Char(36)
  getorioTenantId String      @map("getorio_tenant_id") @db.VarChar(64)
  orderRef        String      @unique @map("order_ref") @db.VarChar(32)
  idempotencyKey  String      @map("idempotency_key") @db.VarChar(128)
  /// SHA-256 of the normalized checkout request, to detect a reused key with a different cart.
  requestHash     String      @default("") @map("request_hash") @db.Char(64)
  status          OrderStatus @default(pending_sync)
  customerName    String      @map("customer_name") @db.VarChar(120)
  customerPhone   String      @map("customer_phone") @db.VarChar(20)
  customerEmail   String?     @map("customer_email") @db.VarChar(254)
  address         String      @db.VarChar(250)
  city            String      @db.VarChar(80)
  notes           String?     @db.VarChar(500)
  subtotal        Decimal     @db.Decimal(12, 2)
  shippingFee     Decimal     @map("shipping_fee") @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  currency        String      @db.Char(3)
  paymentMethod   String      @map("payment_method") @db.VarChar(20)
  /// Set when checkout used cached stock because Getorio was unreachable (§9.3).
  stockUnverified Boolean     @default(false) @map("stock_unverified")
  /// Coupon applied at checkout (code and amount are snapshots).
  discountId      String?     @map("discount_id") @db.Char(36)
  discountCode    String?     @map("discount_code") @db.VarChar(32)
  discountTotal   Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  /// Linked by account or by phone; drives the merchant's customer profiles.
  customerId      String?     @map("customer_id") @db.Char(36)
  /// True when placed while signed in: only these show in the customer's own account.
  viaAccount      Boolean     @default(false) @map("via_account")
  getorioOrderId  String?     @map("getorio_order_id") @db.VarChar(64)
  syncAttempts    Int         @default(0) @map("sync_attempts")
  lastSyncError   String?     @map("last_sync_error") @db.VarChar(500)
  syncedAt        DateTime?   @map("synced_at") @db.DateTime(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items    OrderItem[]
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  discount Discount?   @relation(fields: [discountId], references: [id], onDelete: SetNull)

  /// Idempotency keys come from browsers, so they are unique per store, not globally.
  @@unique([storeId, idempotencyKey])
  @@index([storeId, createdAt])
  @@index([status, updatedAt])
  @@index([customerId, createdAt])
  @@index([discountId])
  @@map("orders")
}

model OrderItem {
  id               String   @id @db.Char(36)
  orderId          String   @map("order_id") @db.Char(36)
  getorioTenantId  String   @map("getorio_tenant_id") @db.VarChar(64)
  getorioProductId String   @map("getorio_product_id") @db.VarChar(64)
  variantId        String?  @map("variant_id") @db.VarChar(64)
  sku              String   @db.VarChar(64)
  nameSnapshot     String   @map("name_snapshot") @db.VarChar(200)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  qty              Int
  lineTotal        Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Asset {
  id              String   @id @db.Char(36)
  storeId         String   @map("store_id") @db.Char(36)
  getorioTenantId String   @map("getorio_tenant_id") @db.VarChar(64)
  url             String   @db.VarChar(2048)
  key             String   @db.VarChar(512)
  mime            String   @db.VarChar(100)
  sizeBytes       Int      @map("size_bytes")
  width           Int?
  height          Int?
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("assets")
}

model AuditLog {
  id              String   @id @db.Char(36)
  storeId         String?  @map("store_id") @db.Char(36)
  getorioTenantId String?  @map("getorio_tenant_id") @db.VarChar(64)
  actor           String   @db.VarChar(100)
  action          String   @db.VarChar(100)
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@map("audit_logs")
}

/// Phase 3 analytics: one row per store per day (Asia/Karachi date). Only counters, no visitor
/// data (no IPs, cookies or user agents are stored).
model StoreDailyStat {
  storeId         String   @map("store_id") @db.Char(36)
  getorioTenantId String   @map("getorio_tenant_id") @db.VarChar(64)
  day             DateTime @db.Date
  /// Browser sessions that viewed at least one page.
  visits          Int      @default(0)
  pageViews       Int      @default(0) @map("page_views")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, day])
  @@map("store_daily_stats")
}

/// A store's customer. Created on first order (guest) or at sign-up; one per phone / email per
/// store. Guests have no password. Order counters are kept up to date at checkout.
model Customer {
  id               String    @id @db.Char(36)
  storeId          String    @map("store_id") @db.Char(36)
  getorioTenantId  String    @map("getorio_tenant_id") @db.VarChar(64)
  name             String    @db.VarChar(120)
  /// +923XXXXXXXXX
  phone            String?   @db.VarChar(20)
  /// Lower-cased.
  email            String?   @db.VarChar(254)
  /// scrypt; null for guests who never signed up.
  passwordHash     String?   @map("password_hash") @db.VarChar(255)
  acceptsMarketing Boolean   @default(false) @map("accepts_marketing")
  /// Merchant-only.
  notes            String?   @db.VarChar(1000)
  /// Merchant-only labels, e.g. ["VIP"]. Never filtered on in SQL.
  tags             Json?
  ordersCount      Int       @default(0) @map("orders_count")
  totalSpent       Decimal   @default(0) @map("total_spent") @db.Decimal(12, 2)
  firstOrderAt     DateTime? @map("first_order_at") @db.DateTime(3)
  lastOrderAt      DateTime? @map("last_order_at") @db.DateTime(3)
  lastCity         String?   @map("last_city") @db.VarChar(80)
  registeredAt     DateTime? @map("registered_at") @db.DateTime(3)
  lastLoginAt      DateTime? @map("last_login_at") @db.DateTime(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  orders    Order[]

  @@unique([storeId, phone])
  @@unique([storeId, email])
  @@index([storeId, createdAt])
  @@index([storeId, lastOrderAt])
  @@index([storeId, totalSpent])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @db.Char(36)
  customerId String   @map("customer_id") @db.Char(36)
  label      String   @default("Home") @db.VarChar(40)
  name       String   @db.VarChar(120)
  phone      String   @db.VarChar(20)
  address    String   @db.VarChar(250)
  city       String   @db.VarChar(80)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

/// Discount codes created in the dashboard and redeemed at checkout.
model Discount {
  id               String       @id @db.Char(36)
  storeId          String       @map("store_id") @db.Char(36)
  getorioTenantId  String       @map("getorio_tenant_id") @db.VarChar(64)
  /// Upper-cased.
  code             String       @db.VarChar(32)
  description      String?      @db.VarChar(200)
  type             DiscountType
  /// Percent (1-100) or an amount in the store currency; 0 for free shipping.
  value            Decimal      @db.Decimal(12, 2)
  /// Caps a percentage discount.
  maxDiscount      Decimal?     @map("max_discount") @db.Decimal(12, 2)
  minSubtotal      Decimal?     @map("min_subtotal") @db.Decimal(12, 2)
  usageLimit       Int?         @map("usage_limit")
  perCustomerLimit Int?         @map("per_customer_limit")
  usedCount        Int          @default(0) @map("used_count")
  startsAt         DateTime     @map("starts_at") @db.DateTime(3)
  endsAt           DateTime?    @map("ends_at") @db.DateTime(3)
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, code])
  @@index([storeId, createdAt])
  @@map("discounts")
}
