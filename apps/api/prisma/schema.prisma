// Microstore data model (requirements §7). MySQL 8, InnoDB, utf8mb4.
// Conventions: CHAR(36) UUIDv7 ids generated in app code, DATETIME(3) UTC timestamps,
// DECIMAL(12,2) money, JSON for configs/settings. Every tenant table carries getorio_tenant_id
// and is always queried with it. Never filter on values inside JSON columns.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum MerchantRole {
  owner
  staff
  platform_admin
}

enum StoreStatus {
  draft
  published
  suspended
}

enum DomainType {
  subdomain
  custom
}

enum VersionKind {
  published
  draft_revision
}

enum VersionSource {
  manual
  command
  publish
  restore
  generate
}

enum CommandStatus {
  proposed
  applied
  discarded
  rejected
  error
}

enum OrderStatus {
  pending_sync
  synced
  sync_failed
  cancelled
}

/// Local mapping of a Getorio user who has signed in through SSO.
model Merchant {
  id              String       @id @db.Char(36)
  getorioTenantId String       @map("getorio_tenant_id") @db.VarChar(64)
  getorioUserId   String       @map("getorio_user_id") @db.VarChar(64)
  role            MerchantRole
  lastLoginAt     DateTime     @map("last_login_at") @db.DateTime(3)
  createdAt       DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  stores Store[]

  @@unique([getorioTenantId, getorioUserId])
  @@map("merchants")
}

model Store {
  id                 String      @id @db.Char(36)
  /// One store per Getorio tenant in MVP (see docs/ASSUMPTIONS.md).
  getorioTenantId    String      @unique @map("getorio_tenant_id") @db.VarChar(64)
  ownerUserId        String      @map("owner_user_id") @db.Char(36)
  name               String      @db.VarChar(80)
  status             StoreStatus @default(draft)
  currency           String      @default("PKR") @db.Char(3)
  timezone           String      @default("Asia/Karachi") @db.VarChar(64)
  /// shippingFlatFee, freeShippingThreshold, notifications, whatsappButton, rtl
  settings           Json
  draftConfig        Json        @map("draft_config")
  publishedConfig    Json?       @map("published_config")
  publishedVersionId String?     @map("published_version_id") @db.Char(36)
  publishedAt        DateTime?   @map("published_at") @db.DateTime(3)
  suspendedAt        DateTime?   @map("suspended_at") @db.DateTime(3)
  storageUsedBytes   BigInt      @default(0) @map("storage_used_bytes")
  createdAt          DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  owner         Merchant       @relation(fields: [ownerUserId], references: [id])
  domains       Domain[]
  versions      SiteVersion[]
  commandLogs   CommandLog[]
  storeProducts StoreProduct[]
  orders        Order[]
  assets        Asset[]
  auditLogs     AuditLog[]

  @@index([ownerUserId])
  @@map("stores")
}

/// Tenant resolution uses only this table (FR-9.2).
model Domain {
  id                 String     @id @db.Char(36)
  storeId            String     @map("store_id") @db.Char(36)
  getorioTenantId    String     @map("getorio_tenant_id") @db.VarChar(64)
  hostname           String     @unique @db.VarChar(253)
  type               DomainType
  verified           Boolean    @default(false)
  isPrimary          Boolean    @default(false) @map("is_primary")
  /// Old subdomains keep redirecting to the new primary for 30 days (FR-6.6).
  redirectToDomainId String?    @map("redirect_to_domain_id") @db.Char(36)
  redirectExpiresAt  DateTime?  @map("redirect_expires_at") @db.DateTime(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.DateTime(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("domains")
}

model SiteVersion {
  id              String        @id @db.Char(36)
  storeId         String        @map("store_id") @db.Char(36)
  getorioTenantId String        @map("getorio_tenant_id") @db.VarChar(64)
  kind            VersionKind
  config          Json
  label           String?       @db.VarChar(120)
  createdBy       String?       @map("created_by") @db.Char(36)
  source          VersionSource
  createdAt       DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, kind, createdAt])
  @@map("site_versions")
}

model CommandLog {
  id               String        @id @db.Char(36)
  storeId          String        @map("store_id") @db.Char(36)
  getorioTenantId  String        @map("getorio_tenant_id") @db.VarChar(64)
  userId           String        @map("user_id") @db.Char(36)
  commandText      String        @map("command_text") @db.VarChar(300)
  model            String        @db.VarChar(100)
  promptTokens     Int           @default(0) @map("prompt_tokens")
  completionTokens Int           @default(0) @map("completion_tokens")
  status           CommandStatus
  rejectionReason  String?       @map("rejection_reason") @db.VarChar(500)
  patch            Json?
  latencyMs        Int           @default(0) @map("latency_ms")
  createdAt        DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@map("command_logs")
}

model StoreProduct {
  id               String   @id @db.Char(36)
  storeId          String   @map("store_id") @db.Char(36)
  getorioTenantId  String   @map("getorio_tenant_id") @db.VarChar(64)
  getorioProductId String   @map("getorio_product_id") @db.VarChar(64)
  visible          Boolean  @default(true)
  featured         Boolean  @default(false)
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, getorioProductId])
  @@index([storeId, visible])
  @@map("store_products")
}

model Order {
  id              String      @id @db.Char(36)
  storeId         String      @map("store_id") @db.Char(36)
  getorioTenantId String      @map("getorio_tenant_id") @db.VarChar(64)
  orderRef        String      @unique @map("order_ref") @db.VarChar(32)
  idempotencyKey  String      @map("idempotency_key") @db.VarChar(128)
  /// SHA-256 of the normalized checkout request, to detect a reused key with a different cart.
  requestHash     String      @default("") @map("request_hash") @db.Char(64)
  status          OrderStatus @default(pending_sync)
  customerName    String      @map("customer_name") @db.VarChar(120)
  customerPhone   String      @map("customer_phone") @db.VarChar(20)
  customerEmail   String?     @map("customer_email") @db.VarChar(254)
  address         String      @db.VarChar(250)
  city            String      @db.VarChar(80)
  notes           String?     @db.VarChar(500)
  subtotal        Decimal     @db.Decimal(12, 2)
  shippingFee     Decimal     @map("shipping_fee") @db.Decimal(12, 2)
  total           Decimal     @db.Decimal(12, 2)
  currency        String      @db.Char(3)
  paymentMethod   String      @map("payment_method") @db.VarChar(20)
  /// Set when checkout used cached stock because Getorio was unreachable (§9.3).
  stockUnverified Boolean     @default(false) @map("stock_unverified")
  getorioOrderId  String?     @map("getorio_order_id") @db.VarChar(64)
  syncAttempts    Int         @default(0) @map("sync_attempts")
  lastSyncError   String?     @map("last_sync_error") @db.VarChar(500)
  syncedAt        DateTime?   @map("synced_at") @db.DateTime(3)
  createdAt       DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.DateTime(3)

  store Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items OrderItem[]

  /// Idempotency keys come from browsers, so they are unique per store, not globally.
  @@unique([storeId, idempotencyKey])
  @@index([storeId, createdAt])
  @@index([status, updatedAt])
  @@map("orders")
}

model OrderItem {
  id               String   @id @db.Char(36)
  orderId          String   @map("order_id") @db.Char(36)
  getorioTenantId  String   @map("getorio_tenant_id") @db.VarChar(64)
  getorioProductId String   @map("getorio_product_id") @db.VarChar(64)
  variantId        String?  @map("variant_id") @db.VarChar(64)
  sku              String   @db.VarChar(64)
  nameSnapshot     String   @map("name_snapshot") @db.VarChar(200)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  qty              Int
  lineTotal        Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model Asset {
  id              String   @id @db.Char(36)
  storeId         String   @map("store_id") @db.Char(36)
  getorioTenantId String   @map("getorio_tenant_id") @db.VarChar(64)
  url             String   @db.VarChar(2048)
  key             String   @db.VarChar(512)
  mime            String   @db.VarChar(100)
  sizeBytes       Int      @map("size_bytes")
  width           Int?
  height          Int?
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("assets")
}

model AuditLog {
  id              String   @id @db.Char(36)
  storeId         String?  @map("store_id") @db.Char(36)
  getorioTenantId String?  @map("getorio_tenant_id") @db.VarChar(64)
  actor           String   @db.VarChar(100)
  action          String   @db.VarChar(100)
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@map("audit_logs")
}
